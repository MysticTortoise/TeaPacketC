include("${TEAPACKET_ROOT}/CMakeCommons/CommonConsts.CMake")

if(NOT COMMAND add_subdirectory_no_overwrite)
    function(add_subdirectory_no_overwrite target_name subdirectory internalDir)
        if(NOT TARGET ${target_name})
            add_subdirectory(${subdirectory} ${internalDir})
        endif()
    endfunction()
endif()

if(NOT COMMAND TP_get_interface_subdirectory)
    function(TP_get_interface_subdirectory variable interfaceName)
        set(${variable} "${TEAPACKET_ROOT}/Modules/${interfaceName}/Interface")
        return(PROPAGATE ${variable})
    endfunction()
endif()

if(NOT COMMAND TP_add_interface_subdirectory)
    function(TP_add_interface_subdirectory interfaceName)
        set(target_name TeaPacket_${interfaceName}_Base)
        TP_get_interface_subdirectory(interfaceDir ${interfaceName})
        if(NOT TARGET ${target_name})
            add_subdirectory_no_overwrite(${target_name} ${interfaceDir} "${interfaceName}Base")
        endif()
    endfunction()
endif()

if(NOT COMMAND TP_add_interface_cpp_subdirectory)
    function(TP_add_interface_cpp_subdirectory interfaceName)
        set(target_name TeaPacket_${interfaceName}_CPP)
        set(subdir "${TEAPACKET_ROOT}/Wrappers/CPP/${interfaceName}")
        if(NOT TARGET ${target_name})
            add_subdirectory_no_overwrite(${target_name} ${subdir} "${interfaceName}CPP")
        endif()
    endfunction()
endif()

if(NOT COMMAND TP_add_impl_subdirectory)
    function(TP_add_impl_subdirectory moduleName implName)
        message(${moduleName}${implName})
        set(target_name TeaPacket_${moduleName}_${implName})
        set(subdir "${TEAPACKET_ROOT}/Modules/${moduleName}/${implName}")
        if(NOT TARGET ${target_name})
            add_subdirectory_no_overwrite(${target_name} ${subdir} "${moduleName}${implName}")
            target_compile_definitions(${target_name} PUBLIC "TeaPacket_${moduleName}_Implemented")
        endif()
    endfunction()
endif()

if(NOT COMMAND TP_add_extension_subdirectory)
    function(TP_add_extension_subdirectory extensionName)
        message(${extensionName})
        
        string(REPLACE / _ target_name_suffix "${extensionName}")
        
        set(target_name TeaPacket_Extension_${target_name_suffix})
        set(subdir "${TEAPACKET_ROOT}/Extensions/${extensionName}")
        if(NOT TARGET ${target_name})
            add_subdirectory_no_overwrite(${target_name} ${subdir} "${extensionName}")
        endif()
    endfunction()
endif()

if(NOT COMMAND TP_add_bundle)
    function(TP_add_bundle bundleName)
        set(TEAPACKET_BUNDLE_TARGET ${targetName})
        include("${TEAPACKET_ROOT}/Bundles/Common.CMake")
        include("${TEAPACKET_ROOT}/Bundles/${bundleName}.CMake")
        message("Adding BUNDLE ${bundleName}")
    endfunction()
endif()

if(NOT COMMAND TP_build_bundle)
    function(TP_build_bundle bundleName)
        set(TARGET_NAME "TeaPacket_${bundleName}_Bundle")
        if(TARGET ${TARGET_NAME})
            return()
        endif ()
        add_library(${TARGET_NAME} INTERFACE)

        foreach(MODULE IN LISTS TP_MODULE_NO_IMPL_LIST)
            TP_add_interface_subdirectory(${MODULE})
            target_link_libraries(${TARGET_NAME} INTERFACE "TeaPacket_${MODULE}_Base")
        endforeach ()

        foreach(MODULE IN LISTS TP_MODULE_WITH_IMPL_LIST)
            set(IMPL_VAR_NAME "TP_Bundle_${bundleName}_${MODULE}Lib")
            if(NOT DEFINED ${IMPL_VAR_NAME})
                continue()
            endif ()
            set(IMPL ${${IMPL_VAR_NAME}})
            TP_add_impl_subdirectory(${MODULE} ${IMPL})
            target_link_libraries(${TARGET_NAME} INTERFACE "TeaPacket_${MODULE}_${IMPL}")
        endforeach ()
        message("Building bundle ${TARGET_NAME}")
    endfunction()
endif ()

if(NOT COMMAND TP_link_bundle)
    function(TP_link_bundle targetName bundleName)
        target_link_libraries(${targetName} PUBLIC "TeaPacket_${bundleName}_Bundle")
        cmake_language(CALL "TP_Bundle_${bundleName}_CMakeFunction" ${targetName})
    endfunction()
endif()



if(NOT COMMAND TP_run_python_script)
    function(TP_run_python_script projectName scriptPath)
        cmake_path(GET scriptPath PARENT_PATH scriptDir)
        add_custom_command(
                TARGET ${projectName}
                PRE_BUILD
                COMMENT "Running ${scriptPath}"
                COMMAND python ${scriptPath}
                WORKING_DIRECTORY "${scriptDir}"
                VERBATIM
        )
    endfunction()
endif()